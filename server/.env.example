# Basic configuration
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# SQLite data directory (databases created automatically)
CHURCH_DATA_DIR=./data

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_change_this_in_production
JWT_EXPIRE=30d

# OTC Configuration
OTC_EXPIRE_MINUTES=10
OTC_RESEND_COOLDOWN_SECONDS=60
OTC_SMS_DAILY_LIMIT=10

# Email Configuration
EMAIL_FROM=hello@letmypeoplegrow.com.au
EMAIL_FROM_NAME="Let My People Grow"
EMAIL_DOMAIN=letmypeoplegrow.com.au
CHURCH_NAME="Let My People Grow"

# Brevo API key (required for email authentication)
BREVO_API_KEY=your_brevo_api_key_here

# SMS Configuration (optional - for SMS-based authentication)
CRAZYTEL_API_KEY=your_crazytel_api_key_here
CRAZYTEL_FROM_NUMBER=your_crazytel_from_number_here

# Managed fallback for Settings location autocomplete (optional)
# Create a server-side key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Elvanto Integration Configuration (optional)
# Get these from https://www.elvanto.com/api/getting-started/#oauth
ELVANTO_CLIENT_ID=your_elvanto_client_id_here
ELVANTO_CLIENT_SECRET=your_elvanto_client_secret_here
ELVANTO_REDIRECT_URI=https://localhost/api/integrations/elvanto/callback

# Integration credential encryption key (required once any church connects
# Elvanto or Planning Center — encrypts integration_connections rows).
# Generate with: openssl rand -base64 32
# Must stay stable across restarts/replicas and be backed up separately —
# losing it makes saved integration credentials unrecoverable. See README.md.
INTEGRATION_CREDENTIALS_KEY=

# Kiosk / Self Check-in Configuration (optional - defaults to disabled)
# The self check-in UI currently loads the full church roster into the
# browser for use on an unattended, PIN-locked device. Leave disabled until
# that is redesigned. See docs/superpowers/specs/2026-07-13-kiosk-mode-env-gate-design.md
KIOSK_MODE_ENABLED=false
